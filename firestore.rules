rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userRole() {
      return exists(userDocPath()) ? get(userDocPath()).data.role : '';
    }

    function isAdminRole(role) {
      return role == 'admin'
        || role == 'super_admin'
        || role == 'founder_admin'
        || role == 'manager'
        || role == 'welfare'
        || role == 'founder'
        || role == 'coordinator';
    }

    function isAdmin() {
      return isAuth() && (
        isAdminRole(userRole())
        || exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        || exists(/databases/$(database)/documents/admin-users/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isAuth() && userRole() == 'super_admin';
    }
    
    function userPermissions() {
      return exists(userDocPath()) ? get(userDocPath()).data.get('permissions', []) : [];
    }

    function hasPermission(permission) {
      return isSuperAdmin() || (isAdmin() && permission in userPermissions());
    }
    
    function isOwnUser(userId) {
      return request.auth.uid == userId;
    }
    
    function isBusiness(userId) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      return u.role == 'business'
        || u.get('roles', []).hasAny(['business']);
    }
    
    function isOwnBusiness(businessId) {
      return isAuth() && isBusiness(request.auth.uid) && request.auth.uid == businessId;
    }
    
    // Users collection — own read first (avoids circular get in isAdmin)
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow read: if isAdmin();
      allow create: if isAuth() && isOwnUser(userId) && request.resource.data.role in ['member', 'volunteer', 'business'];
      allow update: if isAdmin() || isOwnUser(userId);
      allow delete: if isAdmin() || isOwnUser(userId);
      
      // User's private data
      match /private/{document=**} {
        allow read, write: if isOwnUser(userId) || isAdmin();
      }
    }
    
    // Admin API Configs - Admin only
    match /apiConfigs/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Site Settings - Public read, admin write
    match /siteSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // YouTube config - Public read, admin write
    match /youtubeConfig/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Pages (CMS) - Public read, admin write
    match /pages/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // FAQs - Public read, admin write
    match /faqs/{document=**} {
      allow read: if true; // Public read for active FAQs
      allow create, update, delete: if isAdmin();
    }
    
    // Policies - Public read (PolicyInitializer + policy pages), admin write
    match /policies/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Platform CMS config - Public read, admin write
    match /platformConfig/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Partner logos (marquee + /partners grid) - Public read, admin write
    match /partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Partners page "Get in touch" submissions — Admin SDK writes via API;
    // keep client create for sanitize path; admin-only read
    match /contactSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if true
        && request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'submittedAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string;
      allow update, delete: if isAdmin();
    }

    // Legacy contact messages (older contact form /admin/contact-requests)
    match /contact-messages/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Testimonials - Public read, admin write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Team members (About page) - Public read, admin write
    match /teamMembers/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Membership pricing plans - Public read, admin write (Part 11 — required for /admin/pricing onSnapshot)
    match /pricingPlans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public contact form submissions (client write) — admin read for /admin/contact-requests
    match /contactRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // Legacy admin user records (management API)
    match /adminUsers/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow write: if isSuperAdmin();
    }

    match /admin-users/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow write: if isSuperAdmin();
    }

    // Donation causes - Public read, admin write (legacy; prefer charityCases)
    match /causes/{causeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Canonical public donation causes (Part 7A/7B)
    match /charityCases/{caseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Charity payment partners used by /donate flow
    match /charityPartners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Payment proof submissions from /donate-confirm
    match /donationSubmissions/{submissionId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'pending_verification'];
      allow update, delete: if isAdmin();
    }

    // Beneficiary support requests — owner or admin can read metadata.
    // Writes are Admin SDK only (POST /api/beneficiary-requests) so clients
    // cannot forge sensitive document URL fields.
    match /beneficiaryRequests/{requestId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    match /beneficiaryConsents/{consentId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // In-app admin alerts (FCM companion) — admin read only; written by Admin SDK
    match /adminNotifications/{notificationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Sponsors - Public read, admin write
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // News - Public read when published, admin write
    match /news/{newsId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // Events - Public read of published events; admin/business create via API + client rules
    match /events/{eventId} {
      allow read: if resource.data.status == 'published' || isAuth();
      allow create: if isAuth() && (isAdmin() || isBusiness(request.auth.uid));
      allow update: if isAdmin() || (isAuth() && resource.data.createdBy == request.auth.uid && isBusiness(request.auth.uid));
      allow delete: if isAdmin() || (isAuth() && resource.data.createdBy == request.auth.uid);

      match /registrations/{registrationId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAdmin();
      }
    }

    // Nested communities (groups, chat, members)
    match /communities/{communityId} {
      allow read: if resource.data.visibility == 'public'
        && resource.data.status == 'active';
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      match /groups/{groupId} {
        allow read: if isAuth();
        allow create, update, delete: if isAdmin();

        match /members/{memberId} {
          allow read: if isAuth();
          allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
          allow update: if isAdmin() || get(/databases/$(database)/documents/communities/$(communityId)/groups/$(groupId)).data.createdBy == request.auth.uid;
          allow delete: if isAdmin()
            || resource.data.userId == request.auth.uid
            || get(/databases/$(database)/documents/communities/$(communityId)/groups/$(groupId)).data.createdBy == request.auth.uid;
        }

        match /messages/{messageId} {
          allow read: if isAuth();
          allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
          allow update, delete: if isAdmin() || resource.data.senderId == request.auth.uid;
        }

        match /posts/{postId} {
          allow read: if isAuth();
          allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isAdmin() || resource.data.authorId == request.auth.uid;

          match /comments/{commentId} {
            allow read: if isAuth();
            allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
            allow update, delete: if isAdmin() || resource.data.authorId == request.auth.uid;
          }
        }

        match /presence/{userId} {
          allow read: if isAuth();
          allow write: if isAuth() && userId == request.auth.uid;
        }
      }

      match /members/{memberId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || resource.data.userId == request.auth.uid;
      }
    }

    match /communityReports/{document=**} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }
    
    // Opportunities - Authenticated read, business write
    match /opportunities/{opportunityId} {
      allow read: if isAuth();
      allow create: if isAuth() && isBusiness(request.auth.uid);
      allow update: if isAdmin() || resource.data.businessId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.businessId == request.auth.uid;
      
      // Applications subcollection
      match /applications/{applicationId} {
        allow read: if isAuth() && (resource.data.applicantId == request.auth.uid || isBusiness(resource.data.businessId));
        allow create: if isAuth() && isOwnUser(request.resource.data.applicantId);
        allow update: if isAdmin() || (isBusiness(get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.businessId) && request.auth.uid == get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.businessId);
      }
    }

    // Business portal profile (server + client reads for dashboard)
    match /businessProfiles/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow read: if isAdmin();
      allow create, update: if isAdmin() || (isAuth() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Business directory profiles — public read for approved+active; owner/admin write
    // Public read also allows referralCode validation for attribution cookies (Part 13C)
    match /businesses/{businessId} {
      allow read: if resource.data.isApproved == true && resource.data.isActive == true
        || isAdmin()
        || (isAuth() && (
          resource.data.userId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || businessId == request.auth.uid
        ));
      allow create: if isAuth() && (
        isAdmin()
        || request.resource.data.userId == request.auth.uid
        || request.resource.data.ownerId == request.auth.uid
        || businessId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (isAuth() && (
        resource.data.userId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || businessId == request.auth.uid
      ));
    }

    // Referral conversions — business reads own referrals; Admin SDK writes
    match /referrals/{referralId} {
      allow read: if isAdmin()
        || (isAuth() && (
          resource.data.businessId == request.auth.uid
          || resource.data.referrerId == request.auth.uid
        ));
      allow create, update, delete: if isAdmin();
    }

    // Business dashboard leads
    match /businessLeads/{leadId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Business referral aggregate doc
    match /businessReferrals/{docId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow create, update: if isAdmin()
        || (isAuth() && request.resource.data.businessId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Business payments & subscriptions
    match /businessPayments/{paymentId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow create: if isAdmin()
        || (isAuth() && request.resource.data.businessId == request.auth.uid);
      allow update: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Business support requests
    match /businessSupportRequests/{requestId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow create: if isAdmin()
        || (isAuth() && request.resource.data.businessId == request.auth.uid);
      allow update: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Business ratings
    match /businessRatings/{ratingId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // Business analytics snapshots
    match /businessAnalytics/{analyticsId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow create, update: if isAdmin()
        || (isAuth() && request.resource.data.businessId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // B2B collaborations between businesses
    match /businessPartnerships/{docId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow create, update: if isAdmin()
        || (isAuth() && request.resource.data.businessId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Partnership / sponsorship requests to admin
    match /partnerships/{docId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.submittedBy == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin()
        || (isAuth()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Part 10B: business creates start as pending_approval; only admin may publish to live statuses
    function isLiveListingStatus(status) {
      return status in ['open', 'published', 'active'];
    }
    function businessCreatePendingOnly() {
      return isAuth()
        && isBusiness(request.auth.uid)
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.status == 'pending_approval';
    }
    // Owner may edit but cannot self-publish (change status into a live value)
    function businessOwnerUpdateNoSelfPublish() {
      return isAuth()
        && resource.data.businessId == request.auth.uid
        && (
          !('status' in request.resource.data.diff(resource.data).affectedKeys())
          || !isLiveListingStatus(request.resource.data.status)
        );
    }

    // Marketplace offers (directory sales / discounts) — public read; owner/admin write
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAdmin() || businessCreatePendingOnly();
      allow update, delete: if isAdmin() || businessOwnerUpdateNoSelfPublish();

      match /purchases/{purchaseId} {
        allow read: if isAdmin()
          || (isAuth() && resource.data.buyerId == request.auth.uid);
        allow create: if isAuth() && request.resource.data.buyerId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // Jobs listings — public read for directory counts/profile; owner/admin write
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAdmin() || businessCreatePendingOnly();
      allow update, delete: if isAdmin() || businessOwnerUpdateNoSelfPublish();

      match /applications/{applicationId} {
        allow read: if isAuth() && (
          isAdmin()
          || resource.data.applicantId == request.auth.uid
          || get(/databases/$(database)/documents/jobs/$(jobId)).data.businessId == request.auth.uid
        );
        allow create: if isAuth() && request.resource.data.applicantId == request.auth.uid;
        allow update: if isAdmin()
          || (isAuth() && get(/databases/$(database)/documents/jobs/$(jobId)).data.businessId == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    // Canonical job applications (member applies → business reviews; admin monitors monthly count)
    match /jobApplications/{applicationId} {
      allow read: if isAuth() && (
        isAdmin()
        || resource.data.applicantId == request.auth.uid
        || resource.data.businessId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && resource.data.businessId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Legacy business portal offers — public read for marketplace directory
    match /businessOffers/{offerId} {
      allow read: if true;
      allow create: if isAdmin() || businessCreatePendingOnly();
      allow update, delete: if isAdmin() || businessOwnerUpdateNoSelfPublish();
    }

    // Legacy business portal opportunities/jobs — public read for directory
    match /businessOpportunities/{opportunityId} {
      allow read: if true;
      allow create: if isAdmin() || businessCreatePendingOnly();
      allow update, delete: if isAdmin() || businessOwnerUpdateNoSelfPublish();
    }

    match /discounts/{discountId} {
      allow read: if true;
      allow create: if isAdmin() || businessCreatePendingOnly();
      allow update, delete: if isAdmin() || businessOwnerUpdateNoSelfPublish();
    }

    match /vendorApplications/{applicationId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAuth() && (isAdmin() || resource.data.businessId == request.auth.uid);
      allow create: if isAuth() || isAdmin();
      allow update, delete: if isAdmin() || (isAuth() && resource.data.businessId == request.auth.uid);
    }
    
    // Donations - Authenticated read, own write (donorId or userId)
    match /donations/{donationId} {
      allow read: if isAdmin()
        || (isAuth() && (
          resource.data.donorId == request.auth.uid
          || resource.data.userId == request.auth.uid
        ));
      allow create: if isAuth() && (
        request.resource.data.donorId == request.auth.uid
        || request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin()
        || (isAuth() && (
          resource.data.donorId == request.auth.uid
          || resource.data.userId == request.auth.uid
        ));
    }
    
    // Campaigns - Public read, admin write
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Newsletter campaigns — admin read/delete; writes via Admin SDK API
    match /newsletters/{document=**} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Bulk newsletter opt-outs — server writes only (Admin SDK)
    match /newsletterUnsubscribes/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    
    // Audit logs — admin read only; writes via Admin SDK API only
    match /auditLogs/{document=**} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }
    
    // System health checks - Public read, service account write
    match /systemHealth/{document=**} {
      allow read: if true;
      allow write: if request.auth.uid != null; // Protected by backend
    }
    
    // Community Statistics - Public read, service account write
    match /communityStats/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platformStats/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // User notifications - Own read/write, admin can read all
    match /users/{userId}/notifications/{document=**} {
      allow read, write: if isOwnUser(userId) || isAdmin();
    }
    
    // Admin Access Codes - Super admin only
    match /adminAccessCodes/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    
    // Admin Audit Logs - Admin only
    match /adminAuditLogs/{document=**} {
      allow read: if isAdmin();
      allow create: if isAuth(); // Anyone can create audit log entries (service logs)
      allow update, delete: if isAdmin();
    }

    // Custom Forms — admin configures; public reads via Admin SDK API only
    match /customForms/{formId} {
      allow read, write: if isAdmin();
    }

    // Form submissions — public creates via /api/forms/submit (Admin SDK); admin reads/updates
    match /formSubmissions/{submissionId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // AI chatbot conversations — owner read/write; admin full access (/admin/chatbot onSnapshot)
    match /conversations/{conversationId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /dmThreads/{threadId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantIds;
        allow create: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantIds;
        allow delete: if isAdmin();
      }
    }

    match /processedStripeSessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    // Volunteer hour logs — member reads own records (/dashboard/volunteering onSnapshot)
    match /volunteerRecords/{recordId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Marketplace orders — member reads own (/dashboard/orders)
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
    }

    // Member certificates and badges (/dashboard/certificates)
    match /certificates/{certificateId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Recurring donations (/dashboard/recurring-donations)
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Learning hub (/dashboard/learning)
    match /learningResources/{resourceId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /workshops/{workshopId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Community reputation leaderboard (/dashboard/community-reputation)
    match /communityReputation/{reputationId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // AI volunteer matching (/dashboard/ai-matches)
    match /aiMatches/{matchId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.volunteerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Volunteer leaderboard aggregates (admin + public read for rankings)
    match /volunteerHours/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /volunteerHoursMonth/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /volunteerHoursYear/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Digital wallet (/dashboard/wallet)
    match /digitalWallets/{walletId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // Activity logs — authenticated client writes; admin reads
    match /activityLogs/{logId} {
      allow create: if isAuth();
      allow read: if isAdmin();
    }

    // Integration usage + health alerts (admin analytics dashboard)
    match /integrationUsage/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /integrationAlerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Event asset library (admin manages; members/business read via API)
    match /assetFolders/{folderId} {
      allow read: if isAuth() && resource.data.status == 'published';
      allow write: if isAdmin();
    }

    match /assetFiles/{fileId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Event registrations (Luma-style guest list)
    // Host/cohost management goes through Admin SDK APIs; client rules cover own + admin.
    match /eventRegistrations/{regId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Default deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
