rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function adminRoleFrom(path) {
      return firestore.get(path).data.adminRole;
    }

    function userRoleFrom(path) {
      return firestore.get(path).data.role;
    }

    function isSensitiveDocAdmin() {
      return isAuth() && (
        (
          firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
          && adminRoleFrom(/databases/(default)/documents/adminUsers/$(request.auth.uid)) in [
            'welfare', 'founder', 'coordinator', 'founder_admin', 'manager',
            'admin', 'super_admin', 'superadmin'
          ]
        )
        || (
          firestore.exists(/databases/(default)/documents/admin-users/$(request.auth.uid))
          && (
            adminRoleFrom(/databases/(default)/documents/admin-users/$(request.auth.uid)) in [
              'welfare', 'founder', 'coordinator', 'founder_admin', 'manager',
              'admin', 'super_admin', 'superadmin'
            ]
            || userRoleFrom(/databases/(default)/documents/admin-users/$(request.auth.uid)) in [
              'welfare', 'founder', 'coordinator', 'founder_admin', 'manager',
              'admin', 'super_admin', 'superadmin'
            ]
          )
        )
        || (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && userRoleFrom(/databases/(default)/documents/users/$(request.auth.uid)) in [
            'admin', 'super_admin', 'welfare', 'founder', 'coordinator', 'founder_admin', 'manager'
          ]
        )
      );
    }

    // Sensitive beneficiary documents — read for welfare-tier + admin / super_admin.
    // Signed URLs from Admin SDK bypass these rules; this covers client SDK reads.
    match /beneficiary-docs/{allPaths=**} {
      allow read: if isSensitiveDocAdmin();
      allow write: if isAuth() && request.resource.size < 15 * 1024 * 1024;
    }
    match /beneficiaryRequests/{allPaths=**} {
      allow read: if isSensitiveDocAdmin();
      allow write: if isAuth() && request.resource.size < 15 * 1024 * 1024;
    }
    match /beneficiary-support/{allPaths=**} {
      allow read: if isSensitiveDocAdmin();
      allow write: if isAuth() && request.resource.size < 15 * 1024 * 1024;
    }
    match /beneficiary-documents/{allPaths=**} {
      allow read: if isSensitiveDocAdmin();
      allow write: if isAuth() && request.resource.size < 15 * 1024 * 1024;
    }

    // All other CMS / donate media (explicit folders used by the app)
    match /charity-cases/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /causes/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /charity-partner-logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 5 * 1024 * 1024;
    }
    match /partner-logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 5 * 1024 * 1024;
    }
    match /donation-proofs/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /partners/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /about/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /homepage/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 15 * 1024 * 1024;
    }
    match /marketplace/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /businesses/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    match /forms/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 10 * 1024 * 1024;
    }
    // Communities: icons, banners, group files (URLs stored in Firestore only)
    match /communities/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 25 * 1024 * 1024;
    }

    // Educational recordings — prefer hosted links for very large files; direct upload up to 500 MB
    match /recordings/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.resource.size < 500 * 1024 * 1024;
    }

    // Remaining CMS / public media (team, news, shop, ads, branding, …).
    // Private prefixes stay denied here so overlapping rules OR with the
    // sensitive matches above (admin-only / auth-only).
    match /{folder}/{rest=**} {
      allow read: if !(folder in [
        'beneficiary-docs',
        'beneficiaryRequests',
        'beneficiary-support',
        'beneficiary-documents',
        'donation-proofs',
        'marketplace-orders'
      ]);
      allow write: if isAuth()
        && !(folder in [
          'beneficiary-docs',
          'beneficiaryRequests',
          'beneficiary-support',
          'beneficiary-documents',
          'donation-proofs',
          'marketplace-orders'
        ])
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
